-- Shared pgTAP helpers. Include inside a test's transaction with:
--   \ir helpers/auth.psql
-- Everything here is created in that transaction and rolled back with it.

create schema if not exists tests;
grant usage on schema tests to anon, authenticated;

-- Creates an auth user (which fires handle_new_user) and returns its id.
create function tests.create_user(p_email text, p_meta jsonb default '{}')
returns uuid
language plpgsql
as $$
declare
  v_id uuid := gen_random_uuid();
begin
  insert into auth.users (id, email, raw_user_meta_data, aud, role)
  values (v_id, p_email, p_meta, 'authenticated', 'authenticated');
  return v_id;
end;
$$;

-- Act as a signed-in user: role authenticated with that user's JWT claims.
create function tests.authenticate_as(p_user_id uuid)
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims',
    json_build_object('sub', p_user_id, 'role', 'authenticated')::text, true);
  execute 'set local role authenticated';
end;
$$;

-- Act as a signed-out visitor.
create function tests.authenticate_as_anon()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '{"role":"anon"}', true);
  execute 'set local role anon';
end;
$$;

-- Back to the test runner's superuser role.
create function tests.clear_authentication()
returns void
language plpgsql
as $$
begin
  perform set_config('request.jwt.claims', '', true);
  execute 'reset role';
end;
$$;

-- A user's Personal workspace (created by handle_new_user since step 3.2).
-- Defaults to the signed-in test user. Definer, so it works under any role.
create function tests.ws(p_user_id uuid default null)
returns uuid
language sql
security definer
set search_path = ''
as $$
  select m.workspace_id
    from public.workspace_members m
    join public.workspaces w on w.id = m.workspace_id
   where m.user_id = coalesce(p_user_id, auth.uid()) and w.name = 'Personal'
   order by w.created_at
   limit 1;
$$;

grant execute on all functions in schema tests to anon, authenticated;
