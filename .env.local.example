# Copy to .env.local. Names only; get local values from `supabase status`.
# Only NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=
# Per-user daily AI spend cap in USD (default 1).
LLM_DAILY_CAP_USD=

# Dev and e2e only: 1 swaps in a fake extraction model (ignored in production).
LLM_FAKE=

# Sentry (step 3.8). The DSN is public (it only allows sending events).
NEXT_PUBLIC_SENTRY_DSN=
# Optional, for readable production stack traces (source-map upload at build).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
